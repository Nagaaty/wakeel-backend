{
  "name": "wakeel-mobile-complete",
  "version": "1.0.0",
  "description": "Wakeel Egypt — Complete Mobile App (React Native + Node.js + PostgreSQL)",
  "private": true,
  "scripts": {
    "backend":         "cd backendV9 && npm start",
    "backend:dev":     "cd backendV9 && npm run dev",
    "backend:install": "cd backendV9 && npm install",
    "backend:migrate": "cd backendV9 && npm run migrate",
    "backend:seed":    "cd backendV9 && npm run seed",
    "mobile":          "cd mobileV9  && npx expo start",
    "mobile:android":  "cd mobileV9  && npx expo start --android",
    "mobile:ios":      "cd mobileV9  && npx expo start --ios",
    "mobile:install":  "cd mobileV9  && npm install",
    "install:all":     "npm run backend:install && npm run mobile:install",
    "setup":           "npm run install:all && npm run backend:migrate && npm run backend:seed",
    "start":           "npm run backend:dev"
  }
}
